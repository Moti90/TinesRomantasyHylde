# OpenAI API-nøgle (kræves til analyse + webresearch)
OPENAI_API_KEY=

# Port (lokalt). På Railway sættes PORT automatisk.
PORT=3847

# Persistens på Railway: mount volume på /data og sæt:
# DATA_DIR=/data

# Postgres (Fase 7) — på Railway: link Postgres-servicen til appen
# så DATABASE_URL sættes automatisk. Lokalt: indsæt connection string.
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_SSL=true

# PirateReads (Tines Goodreads-hylder via api.piratereads.com)
# PIRATEREADS_USER_ID=155251530

# Valgfrit: modeller
# OPENAI_RESEARCH_MODEL=gpt-4o
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Valgfrit: cache (dage)
# RESEARCH_CACHE_DAYS=60
# GOODREADS_CACHE_DAYS=30
